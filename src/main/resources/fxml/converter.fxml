<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>

<GridPane xmlns="http://javafx.com/javafx/21"
          xmlns:fx="http://javafx.com/fxml/1"
          fx:controller="app.controllers.ConverterController"
          hgap="15"
          vgap="12">
    <columnConstraints>
        <ColumnConstraints minWidth="120" />
        <ColumnConstraints minWidth="260" />
    </columnConstraints>
    <Label fx:id="valueLabel"
           text="%value.label"
           GridPane.rowIndex="0"
           GridPane.columnIndex="0" />
    <TextField fx:id="valueField"
               promptText="%value.prompt"
               GridPane.rowIndex="0"
               GridPane.columnIndex="1" />
    <Label fx:id="fromLabel"
           text="%from.label"
           GridPane.rowIndex="1"
           GridPane.columnIndex="0" />
    <ComboBox fx:id="fromUnitComboBox"
              maxWidth="Infinity"
              GridPane.rowIndex="1"
              GridPane.columnIndex="1" />
    <Label fx:id="toLabel"
           text="%to.label"
           GridPane.rowIndex="2"
           GridPane.columnIndex="0" />
    <ComboBox fx:id="toUnitComboBox"
              maxWidth="Infinity"
              GridPane.rowIndex="2"
              GridPane.columnIndex="1" />
    <Label fx:id="unitDescriptionLabel"
           wrapText="true"
           style="-fx-text-fill: #555555;"
           GridPane.rowIndex="3"
           GridPane.columnIndex="1" />
    <Button fx:id="convertButton"
            text="%convert.button"
            GridPane.rowIndex="4"
            GridPane.columnIndex="1" />
</GridPane>
