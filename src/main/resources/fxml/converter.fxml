<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>

<GridPane xmlns="http://javafx.com/javafx/21"
          xmlns:fx="http://javafx.com/fxml/1"
          fx:controller="app.controllers.ConverterController"
          hgap="15"
          vgap="12">
    <columnConstraints>
        <ColumnConstraints minWidth="120" />
        <ColumnConstraints minWidth="220" />
    </columnConstraints>
    <Label fx:id="temperatureLabel"
           text="%temperature.label"
           GridPane.rowIndex="0"
           GridPane.columnIndex="0" />
    <TextField fx:id="temperatureField"
               promptText="%temperature.prompt"
               GridPane.rowIndex="0"
               GridPane.columnIndex="1" />
    <Label fx:id="unitLabel"
           text="%unit.label"
           GridPane.rowIndex="1"
           GridPane.columnIndex="0" />
    <ComboBox fx:id="unitComboBox"
              maxWidth="Infinity"
              GridPane.rowIndex="1"
              GridPane.columnIndex="1" />
    <Button fx:id="calculateButton"
            text="%calculate.button"
            GridPane.rowIndex="2"
            GridPane.columnIndex="1" />
</GridPane>
