<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="app.controllers.ResultsController"
      spacing="8"
      style="-fx-padding: 10; -fx-border-color: #cccccc; -fx-border-radius: 5; -fx-background-color: #f8f8f8;">
    <Label fx:id="resultsTitle"
           text="%results.title"
           style="-fx-font-size: 18px; -fx-font-weight: bold;" />
    <Label fx:id="resultLabel"
           text="%result.empty"
           style="-fx-font-size: 16px;" />
    <Label fx:id="resultDescriptionLabel"
           wrapText="true"
           style="-fx-text-fill: #555555;" />
</VBox>
