FROM eclipse-temurin:21-jdk

WORKDIR /app

# Native libraries needed by JavaFX.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libx11-6 \
    libxext6 \
    libxrender1 \
    libxtst6 \
    libxi6 \
    libgtk-3-0 \
    libgl1 \
    libglx0 \
    wget \
    unzip \
    && rm -rf /var/lib/apt/lists/*

# Download JavaFX SDK.
RUN mkdir -p /javafx-sdk \
    && wget -O /tmp/javafx.zip \
    https://download2.gluonhq.com/openjfx/21/openjfx-21_linux-x64_bin-sdk.zip \
    && unzip /tmp/javafx.zip -d /javafx-sdk \
    && mv /javafx-sdk/javafx-sdk-21/lib /javafx-sdk/lib \
    && rm -rf /javafx-sdk/javafx-sdk-21 /tmp/javafx.zip

# Copy compiled Java classes and resource bundles.
COPY target/classes/ /app/classes/

# Copy runtime dependencies generated by Maven.
COPY target/lib/ /app/lib/

# Configure a display when running with X11 forwarding.
ENV DISPLAY=host.docker.internal:0.0

# Launch the JavaFX application.
CMD ["java", \
    "--module-path", "/javafx-sdk/lib", \
    "--add-modules", "javafx.controls,javafx.fxml", \
    "-Dprism.order=sw", \
    "-cp", "/app/classes:/app/lib/*", \
    "app.Main"]

